# Configuración de producción para el proyecto apicca-com.
# Firebase Functions v2 carga automáticamente este archivo al hacer deploy.
#
# Pasos para activar App Check:
#   1. Firebase Console → App Check → Registrar app web con reCAPTCHA v3
#   2. Pegar el site key en public/js/firebase-client.js (RECAPTCHA_SITE_KEY)
#   3. Cambiar el valor de abajo a "true" y hacer firebase deploy
ENFORCE_APP_CHECK=false

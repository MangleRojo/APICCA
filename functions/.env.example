# Configuración para Firebase Functions - Re(s)etario APICCA COMÚN
#
# DESARROLLO LOCAL (emulador):
#   Copia este archivo a .env y completa con tus valores reales.
#   El emulador los carga automáticamente.
#
# PRODUCCIÓN (Firebase Secrets):
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set FILE_SEARCH_STORE_NAME
#   Los secrets se inyectan automáticamente al deploy.

# API Key de Google Gemini
# Obtenerla en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Nombre del File Search Store en Google AI Studio
# Crear en: https://aistudio.google.com/app/data_stores
# Este store debe contener los documentos del Re(s)etario:
# - Resetario.md
# - Definiciones de glyphs
# - Combinaciones de tácticas
# - Otros documentos contextuales
FILE_SEARCH_STORE_NAME=nombre_del_store_aqui

# Activar verificación de App Check en producción.
# Requiere habilitar App Check en Firebase Console y registrar el dominio.
# En el emulador local deja este valor vacío o en "false".
ENFORCE_APP_CHECK=false
